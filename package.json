{
  "name": "mega-tetris",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A cheerful, fast-loading falling-block puzzle game for the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "a11y": "vitest run src/ui/a11y.test.ts src/ui/style.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
